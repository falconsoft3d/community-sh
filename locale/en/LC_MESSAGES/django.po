msgstr "Browser (WhatsApp Web)"

#: orchestrator/templates/orchestrator/instance_detail.html:680
msgid ""
"Google Chrome dentro del contenedor de Odoo, para los módulos que lo "
"necesitan, como WhatsApp Web. Ocupa unos 450 MB y se reinstala solo en cada "
"despliegue (menos de un minuto más)."
msgstr "Google Chrome inside the Odoo container, for the modules that need it, such as WhatsApp Web. It takes about 450 MB and is reinstalled automatically on every deploy (less than a minute more)."

#: orchestrator/templates/orchestrator/instance_detail.html:686
msgid "Instalado"
msgstr "Installed"

#: orchestrator/templates/orchestrator/instance_detail.html:688
msgid "¿Dejar de instalar Google Chrome? Desaparece en el próximo despliegue."
msgstr "Stop installing Google Chrome? It goes away on the next deploy."

