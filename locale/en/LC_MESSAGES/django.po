"Describe el módulo o el cambio que quieres… Usa @ para etiquetar un módulo"
msgstr "Describe the module or the change you want… Use @ to tag a module"

#: orchestrator/templates/orchestrator/instance_detail.html:1224
msgid "Enviar"
msgstr "Send"

#: orchestrator/templates/orchestrator/instance_detail.html:1233
msgid ""
