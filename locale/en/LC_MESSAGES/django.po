#: orchestrator/templates/orchestrator/home.html:434
msgid "Actual"
msgstr "Current"

#: orchestrator/templates/orchestrator/home.html:455
msgid "Guías y novedades"
msgstr "Guides and news"

#: orchestrator/templates/orchestrator/home.html:458
msgid "Ver todo"
msgstr "View all"

#: orchestrator/templates/orchestrator/home.html:468
