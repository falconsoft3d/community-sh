#: orchestrator/templates/orchestrator/home.html:480
msgid "Libre, abierto y tuyo"
msgstr "Free, open and yours"

#: orchestrator/templates/orchestrator/home.html:482
msgid ""
"Community SH es gratuito y de código abierto. Instálalo en tu servidor, "
"adáptalo a tu equipo o contribuye al proyecto."
msgstr ""
"Community SH is free and open source. Install it on your server, adapt it to "
"your team or contribute to the project."

